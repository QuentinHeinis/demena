NUXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# PWA / notifications push : clé publique VAPID générée avec `npx web-push generate-vapid-keys`
# La clé privée reste côté Supabase (secret de Edge Function), jamais ici.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optionnel : la clé secrète (sb_secret_...) ne doit JAMAIS être prefixée NUXT_PUBLIC_
# et n'est pas utilisée par cette application (tout passe par le navigateur + RLS).
